{
  "name": "expo-eas",
  "main": "expo-router/entry",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "dev:client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "update:preview": "eas update --branch preview --message \"$npm_config_message\"",
    "update:prod": "eas update --branch production --message \"$npm_config_message\"",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:reset:migrations": "rm -rf db/migrations && drizzle-kit generate --name init",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@hookform/resolvers": "^5.9.1",
    "drizzle-orm": "1.0.0-rc.4",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "^58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "immer": "^11.2.9",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "lightningcss": "1.30.1",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "8.5.31",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "4.1.12",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1"
    }
  }
}
