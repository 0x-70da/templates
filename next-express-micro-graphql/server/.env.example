# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=express_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_db

# Better Auth
BETTER_AUTH_SECRET=replace_with_a_secure_random_secret
BETTER_AUTH_URL=http://localhost:5000

# Testing
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_test
