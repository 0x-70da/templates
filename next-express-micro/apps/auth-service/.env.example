PORT=4001
NODE_ENV=development
LOG_LEVEL=info
INTERNAL_SECRET=change-me

# Database auth_service is created by `pnpm db:ensure`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service
# Integration tests only. Must be a different database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service_test

# 32+ chars, generated by `pnpm env:setup`
BETTER_AUTH_SECRET=change-me
# PUBLIC origin that users/browsers see (the Next.js client), NOT this service's own URL
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated, must include BETTER_AUTH_URL's origin
TRUSTED_ORIGINS=http://localhost:3000

# JWT settings: must match the gateway
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=next-express-micro
JWT_EXPIRES_IN=15m