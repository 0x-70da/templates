PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Shared secret between the gateway and EVERY service (must be identical everywhere).
# `pnpm env:setup` generates it. Min 16 chars (32+ in production).
INTERNAL_SECRET=change-me

# One <NAME>_SERVICE_URL per entry in src/services.registry.ts.
# docker-compose.yaml overrides these with container hostnames.
AUTH_SERVICE_URL=http://localhost:4001
TEST_SERVICE_URL=http://localhost:4002

# Comma-separated browser origins allowed by CORS (the Next.js client)
CORS_ORIGINS=http://localhost:3000

# JWT settings: must match auth-service
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=next-express-micro
# Optional, defaults to ${AUTH_SERVICE_URL}/api/auth/jwks
# JWKS_URL=http://localhost:4001/api/auth/jwks

COOKIE_EXCHANGE_CACHE_TTL_MS=5000
PROXY_TIMEOUT_MS=10000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Number of reverse proxies in front of the gateway (direct = 0, nginx/caddy = 1)
TRUST_PROXY=0