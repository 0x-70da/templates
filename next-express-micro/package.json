{
  "name": "next-express-micro",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p scripts/tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "db:up": "docker compose -f docker-compose.dev.yaml up -d --wait db",
    "db:down": "docker compose -f docker-compose.dev.yaml down",
    "db:ensure": "tsx scripts/ensure-databases.ts",
    "db:info": "tsx scripts/db-info.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "gen:service": "tsx scripts/new-service.ts",
    "env:setup": "tsx scripts/env.ts setup",
    "env:check": "tsx scripts/env.ts check",
    "env:check:example": "tsx scripts/env.ts check --example",
    "predev": "pnpm env:setup && pnpm env:check && pnpm db:up && pnpm db:ensure",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pg": "^8.23.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "turbo": "2.11.13",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  }
}
