FROM node:24-alpine AS base RUN corepack enable && npm i -g turbo WORKDIR /app FROM base AS pruner
COPY . . RUN turbo prune
{{kebabCase name}}-service --docker FROM base AS builder COPY --from=pruner /app/out/json/ . RUN
pnpm install --frozen-lockfile COPY --from=pruner /app/out/full/ . RUN turbo run build --filter={{kebabCase
  name
}}-service FROM node:24-alpine AS runner WORKDIR /app ENV NODE_ENV=production COPY --from=builder
/app/apps/{{kebabCase name}}-service/dist ./apps/{{kebabCase name}}-service/dist COPY --from=builder
/app/node_modules ./node_modules COPY --from=builder /app/apps/{{kebabCase
  name
}}-service/package.json ./apps/{{kebabCase name}}-service/package.json WORKDIR /app/apps/{{kebabCase
  name
}}-service EXPOSE
{{port}}
CMD ["node", "dist/server.js"]