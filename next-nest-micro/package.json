{
  "name": "next-nest-micro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm --dir server dev\" \"pnpm --dir client dev\"",
    "build": "pnpm --dir server build && pnpm --dir client build",
    "start": "concurrently \"pnpm --dir server start\" \"pnpm --dir client start\"",
    "lint": "pnpm --dir server lint && pnpm --dir client lint",
    "lint:fix": "pnpm --dir server lint:fix && pnpm --dir client lint:fix",
    "lint:ci": "pnpm --dir server lint:ci && pnpm --dir client lint:ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --dir server typecheck && pnpm --dir client typecheck",
    "test": "pnpm --dir server test && pnpm --dir client test && pnpm test:contract",
    "test:contract": "tsx scripts/check-contracts.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yaml up -d",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  }
}
