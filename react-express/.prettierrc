{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "tailwindStylesheet": "./packages/ui/src/styles/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "plugins": ["prettier-plugin-tailwindcss"]
}
